# INACTIVE example only. Prefer the reviewed, temporary
# .github/workflows/gtk-e2e-on-approval.yml after explicit authorization.
# Never publish packages-lock.json, a raw cache folder or checkout tarball.
# Remove the temporary workflow after the #1011 local GTK qualification.
name: GTK Debian 13 dependency relay (example)

on:
  workflow_dispatch:
    inputs:
      confirm_relay:
        description: "I explicitly authorize a bounded Debian GTK dependency download"
        required: true
        default: false
        type: boolean

permissions:
  contents: read

jobs:
  build-cache:
    if: inputs.confirm_relay == true
    runs-on: ubuntu-24.04
    timeout-minutes: 30

    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false

      - name: Build Debian 13 signed APT cache
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p .gtk-deb-cache
          docker run --rm \
            -v "$GITHUB_WORKSPACE:/work" \
            -w /work/environnements/openai-chat-debian \
            debian:trixie \
            bash -lc '
              set -euo pipefail
              apt-get update -o APT::Update::Error-Mode=any
              apt-get install -y --no-install-recommends \
                python3 ca-certificates debian-archive-keyring apt-utils dpkg tar xz-utils
              python3 bootstrap.py \
                --download-only \
                --deb-cache /work/.gtk-deb-cache
            '
          sudo chown -R "$(id -u):$(id -g)" .gtk-deb-cache
          # Fail closed if anything else landed in the cache.
          python3 scripts/ci-validate-gtk-relay-cache.py \
            --cache "$GITHUB_WORKSPACE/.gtk-deb-cache" \
            --output "$RUNNER_TEMP/gtk4-deb-cache-debian13-trixie-amd64.tar.gz"
          (cd "$RUNNER_TEMP" && sha256sum gtk4-deb-cache-debian13-trixie-amd64.tar.gz > SHA256SUMS)

      - name: Upload allowlisted packages only
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: gtk4-deb-cache-debian13-trixie-amd64
          path: |
            ${{ runner.temp }}/gtk4-deb-cache-debian13-trixie-amd64.tar.gz
            ${{ runner.temp }}/SHA256SUMS
          if-no-files-found: error
          retention-days: 2
          compression-level: 0
