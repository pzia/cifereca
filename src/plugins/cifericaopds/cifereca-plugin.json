{
  "manifest": 1,
  "package": {
    "id": "org.cifereca.integration.cifericaopds",
    "version": "0.1.1",
    "name": "CifericaOPDS — sources dynamiques (pilote)",
    "publisher": "cifereca",
    "plugin_api": ">=1.4.1,<2"
  },
  "plugins": [
    {
      "id": "org.cifereca.integration.cifericaopds",
      "type": "provider.collection",
      "version": "0.1.1",
      "entrypoint": "cifereca_cifericaopds:PLUGIN",
      "display_name": "CifericaOPDS — sources dynamiques",
      "description": "Plugin expérimental, fixtures par défaut ; profil HTTP v0.2 candidat non attesté.",
      "enabled_by_default": false,
      "instantiation": "singleton_public",
      "priority": 35,
      "capabilities": [
        "provider.collection.discovery",
        "catalog.search"
      ],
      "config_schema": {
        "type": "object",
        "x-cifereca-scope": "plugin",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "fixture",
              "candidate_v02"
            ],
            "default": "fixture",
            "title": "Profil",
            "description": "HTTP candidat non attesté"
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "default": "http://127.0.0.1:8788",
            "title": "URL du serveur"
          },
          "timeout_seconds": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 20,
            "default": 4
          },
          "show_synthetic": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "help_text": "Désactivé par défaut. Fournit une collection de providers virtuels sans import de code distant ni accès aux registres Core privés. Mode fixture sans réseau ; HTTP candidate_v02 seulement sur décision explicite, non certifié sur le serveur réel. Pas de droits d'achat, emprunt ou téléchargement, ni SSE/jobs, ni bearer. Pour activer le plugin, installer au préalable la PR Core #970.",
      "requires": [],
      "recommends": [],
      "system_requires": [],
      "requires_brokers": [
        "httpx"
      ],
      "requires_contracts": []
    }
  ]
}
