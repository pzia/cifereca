{
  "manifest": 1,
  "package": {
    "id": "org.cifereca.epub-optimizer",
    "version": "0.3.6",
    "name": "Cifereca EPUB/PDF Optimizer",
    "publisher": "Cifereca",
    "plugin_api": ">=1.4,<2"
  },
  "plugins": [
    {
      "id": "document.transformer.epub-optimizer",
      "type": "document.transformer",
      "version": "0.3.6",
      "entrypoint": "cifereca_epub_optimizer_transformer:PLUGIN",
      "display_name": "Optimiseur EPUB e-ink",
      "description": "Transforme un EPUB sans DRM en variante e-ink en optimisant prudemment les images raster et en préservant les contenus à sémantique sensible.",
      "help_text": "Transformer EPUB conservateur : validation OCF stricte avant lecture (mimetype exact, première entrée, Stored, sans extra field ni whitespace ; compression ZIP limitée à Stored/Deflate ; taille décompressée bornée, chemins canoniques, doublons/chiffrement/symlinks refusés), puis optimisation prudente des images raster. Original préservé.",
      "instantiation": "singleton_public",
      "enabled_by_default": true,
      "priority": 50,
      "requires": [],
      "recommends": [],
      "capabilities": [
        "artifact.plan",
        "artifact.transform"
      ],
      "system_requires": [
        {
          "type": "python-package",
          "name": "Pillow",
          "version": ">=11,<13",
          "import": "PIL"
        }
      ],
      "config_schema": {
        "type": "object",
        "x-cifereca-scope": "plugin",
        "additionalProperties": false,
        "properties": {
          "default_profile": {
            "type": "string",
            "default": "device.profile.xteink-x3"
          },
          "cpu_workers": {
            "type": "integer",
            "enum": [1, 2, 4],
            "default": 1,
            "title": "Processus CPU EPUB",
            "description": "Opt-in ; 1 = séquentiel, 2/4 = images EPUB en processus spawn bornés."
          },
          "max_uncompressed_mb": {
            "type": "integer",
            "minimum": 64,
            "maximum": 4096,
            "default": 2048
          },
          "max_image_mb": {
            "type": "integer",
            "minimum": 8,
            "maximum": 512,
            "default": 64
          },
          "max_image_pixels": {
            "type": "integer",
            "minimum": 1000000,
            "maximum": 250000000,
            "default": 64000000
          }
        }
      },
      "requires_brokers": [],
      "requires_contracts": [
        {
          "category": "device.profile",
          "contract": "cifereca.device.profile",
          "version": ">=1,<2",
          "mode": "required",
          "capabilities": [
            "device.profile.describe"
          ]
        }
      ]
    },
    {
      "id": "document.transformer.pdf-eink-optimizer",
      "type": "document.transformer",
      "version": "0.3.6",
      "entrypoint": "cifereca_pdf_optimizer_transformer:PLUGIN",
      "display_name": "Optimiseur PDF e-ink",
      "description": "Crée une variante PDF e-ink en conservant texte/vectoriel et en optimisant seulement les images raster compatibles.",
      "help_text": "Transformer PDF→PDF conservateur via artifact.execution. Refuse les PDF nécessitant un mot de passe et les PDF signés ; aucune rasterisation de page.",
      "instantiation": "singleton_public",
      "enabled_by_default": true,
      "priority": 50,
      "requires": [],
      "recommends": [],
      "capabilities": [
        "artifact.plan",
        "artifact.transform"
      ],
      "system_requires": [
        {
          "type": "python-package",
          "name": "Pillow",
          "version": ">=11,<13",
          "import": "PIL"
        },
        {
          "type": "python-package",
          "name": "PyMuPDF",
          "version": ">=1.26,<2",
          "import": "pymupdf"
        }
      ],
      "config_schema": {
        "type": "object",
        "x-cifereca-scope": "plugin",
        "additionalProperties": false,
        "properties": {
          "default_profile": {
            "type": "string",
            "default": "device.profile.xteink-x3"
          },
          "max_pdf_pages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000,
            "default": 5000
          },
          "max_image_mb": {
            "type": "integer",
            "minimum": 8,
            "maximum": 512,
            "default": 64
          },
          "max_image_pixels": {
            "type": "integer",
            "minimum": 1000000,
            "maximum": 250000000,
            "default": 64000000
          },
          "cpu_workers": {
            "type": "integer",
            "enum": [1, 2, 4],
            "default": 1,
            "title": "Processus CPU PDF",
            "description": "Opt-in ; 1 = séquentiel, 2/4 = lots Pillow bornés en processus spawn. PyMuPDF reste dans le coordinateur."
          }
        }
      },
      "requires_brokers": [],
      "requires_contracts": [
        {
          "category": "device.profile",
          "contract": "cifereca.device.profile",
          "version": ">=1,<2",
          "mode": "required",
          "capabilities": [
            "device.profile.describe"
          ]
        }
      ]
    },
    {
      "id": "device.profile.xteink-x3",
      "type": "device.profile",
      "version": "0.3.6",
      "entrypoint": "cifereca_epub_optimizer_profiles:XTEINK_X3_PLUGIN",
      "display_name": "Xteink X3 / CrossPoint",
      "description": "Profil 528×792, 4 niveaux de gris.",
      "help_text": "Profil indépendant pour EPUB Optimizer ; peut être désactivé sans désactiver le transformer.",
      "instantiation": "singleton_public",
      "enabled_by_default": true,
      "requires": [],
      "recommends": [],
      "capabilities": [
        "device.profile.describe"
      ],
      "system_requires": [],
      "requires_brokers": [],
      "requires_contracts": []
    },
    {
      "id": "device.profile.xteink-x4",
      "type": "device.profile",
      "version": "0.3.6",
      "entrypoint": "cifereca_epub_optimizer_profiles:XTEINK_X4_PLUGIN",
      "display_name": "Xteink X4 / CrossPoint",
      "description": "Profil 480×800, 4 niveaux de gris.",
      "help_text": "Profil indépendant pour EPUB Optimizer ; peut être désactivé sans désactiver le transformer.",
      "instantiation": "singleton_public",
      "enabled_by_default": true,
      "requires": [],
      "recommends": [],
      "capabilities": [
        "device.profile.describe"
      ],
      "system_requires": [],
      "requires_brokers": [],
      "requires_contracts": []
    },
    {
      "id": "device.profile.kobo-clara-bw",
      "type": "device.profile",
      "version": "0.3.6",
      "entrypoint": "cifereca_epub_optimizer_profiles:KOBO_CLARA_BW_PLUGIN",
      "display_name": "Kobo Clara BW",
      "description": "Profil 1072×1448, 300 ppp, niveaux de gris 8 bits.",
      "help_text": "Profil indépendant pour EPUB Optimizer ; peut être désactivé sans désactiver le transformer.",
      "instantiation": "singleton_public",
      "enabled_by_default": true,
      "requires": [],
      "recommends": [],
      "capabilities": [
        "device.profile.describe"
      ],
      "system_requires": [],
      "requires_brokers": [],
      "requires_contracts": []
    },
    {
      "id": "device.profile.generic-eink",
      "type": "device.profile",
      "version": "0.3.6",
      "entrypoint": "cifereca_epub_optimizer_profiles:GENERIC_EINK_PLUGIN",
      "display_name": "E-ink générique",
      "description": "Profil prudent 1200×1600 en niveaux de gris.",
      "help_text": "Profil indépendant pour EPUB Optimizer ; peut être désactivé sans désactiver le transformer.",
      "instantiation": "singleton_public",
      "enabled_by_default": true,
      "requires": [],
      "recommends": [],
      "capabilities": [
        "device.profile.describe"
      ],
      "system_requires": [],
      "requires_brokers": [],
      "requires_contracts": []
    },
    {
      "id": "ui.page.epub-optimizer",
      "type": "ui.page",
      "version": "0.3.6",
      "entrypoint": "cifereca_epub_optimizer_plugin:PLUGIN",
      "display_name": "Optimiseur EPUB / PDF e-ink",
      "description": "Page de recette et action book.detail pour créer une variante e-ink EPUB ou PDF.",
      "help_text": "Ajoute l’action Optimiser… aux EPUB et PDF locaux non DRM. Le Core gère tâches, progression, annulation, leases, persistance et réutilisation des variantes identiques. Laboratoire IA facultatif désactivé par défaut : simplification, résumé ou glossaire sur un extrait collé (20–1600 caractères) seulement après consentement et clic. Réponse marquée générée, avec provenance, sans lecture automatique du livre et sans modifier ni créer d'EPUB/PDF. Les transformations classiques restent déterministes et indépendantes.",
      "instantiation": "singleton_public",
      "enabled_by_default": true,
      "requires": [
        {
          "plugin": "document.transformer.epub-optimizer",
          "version": ">=0.3.1,<1"
        },
        {
          "plugin": "document.transformer.pdf-eink-optimizer",
          "version": ">=0.3.1,<1"
        }
      ],
      "recommends": [],
      "capabilities": [
        "ui.detail.action"
      ],
      "system_requires": [
        {
          "type": "python-package",
          "name": "Pillow",
          "version": ">=11,<13",
          "import": "PIL"
        },
        {
          "type": "python-package",
          "name": "PyMuPDF",
          "version": ">=1.26,<2",
          "import": "pymupdf"
        }
      ],
      "config_schema": {
        "type": "object",
        "x-cifereca-scope": "plugin",
        "additionalProperties": false,
        "properties": {
          "default_profile": {
            "type": "string",
            "default": "device.profile.xteink-x3"
          },
          "max_uncompressed_mb": {
            "type": "integer",
            "minimum": 64,
            "maximum": 4096,
            "default": 2048
          },
          "max_pdf_pages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000,
            "default": 5000
          },
          "max_image_mb": {
            "type": "integer",
            "minimum": 8,
            "maximum": 512,
            "default": 64
          },
          "max_image_pixels": {
            "type": "integer",
            "minimum": 1000000,
            "maximum": 250000000,
            "default": 64000000
          },
          "llm_semantic_preview": {
            "type": "boolean",
            "default": false,
            "title": "Laboratoire IA : prévisualisation sémantique",
            "description": "Affiche une prévisualisation facultative à partir d'un extrait collé volontairement. Le service LLM peut être distant. Ne lit aucun fichier et ne produit aucune variante EPUB."
          }
        }
      },
      "requires_brokers": [
        "artifact.execution",
        "tasks"
      ],
      "requires_contracts": []
    }
  ]
}
