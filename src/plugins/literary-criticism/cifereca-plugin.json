{
  "manifest": 1,
  "package": {
    "id": "org.cifereca.literary-criticism",
    "version": "0.3.1",
    "name": "Critique littéraire",
    "publisher": "CIFERECA",
    "plugin_api": ">=1.4,<2"
  },
  "categories": [
    {
      "id": "criticism.source",
      "display_name": "Source de critiques littéraires",
      "contract": "cifereca.criticism-source/1",
      "resolution": "all",
      "description": "Sources indépendantes de critiques, collectées et rapprochées des livres par preuves bibliographiques explicites."
    },
    {
      "id": "criticism.index",
      "display_name": "Index de critiques",
      "contract": "cifereca.criticism-index/1",
      "resolution": "single"
    }
  ],
  "plugins": [
    {
      "id": "literary.criticism",
      "type": "criticism.index",
      "version": "0.2.0",
      "entrypoint": "literary_criticism:PLUGIN",
      "display_name": "Critique littéraire",
      "description": "Agrège des critiques publiques, les déduplique et les rattache aux livres par preuves explicables.",
      "help_text": "Index de critiques avec preuves ISBN, URL ou titre/auteur ; les éditions contradictoires restent des suggestions. Aucune collecte implicite.",
      "enabled_by_default": false,
      "priority": -100,
      "instantiation": "singleton_public",
      "capabilities": [
        "criticism.index",
        "criticism.discover",
        "criticism.match"
      ],
      "requires": [],
      "recommends": [],
      "requires_brokers": [],
      "requires_contracts": [],
      "system_requires": []
    },
    {
      "id": "ui.page.literary-criticism",
      "type": "ui.page",
      "version": "0.2.0",
      "entrypoint": "criticism_page:PLUGIN",
      "display_name": "Critiques littéraires",
      "description": "Sources et critiques associées depuis la fiche d’un livre.",
      "help_text": "Lecture du cache local à l’ouverture. Ajouter un flux le laisse désactivé ; activez-le puis lancez Actualiser. Filtres source, langue, date. Navigation locale optionnelle Core #737.",
      "enabled_by_default": false,
      "priority": -100,
      "instantiation": "singleton_public",
      "requires_brokers": [
        "tasks"
      ],
      "requires_contracts": [
        {
          "category": "criticism.source",
          "contract": "cifereca.criticism-source",
          "version": ">=1,<2",
          "mode": "optional"
        }
      ],
      "system_requires": [
        {
          "type": "python-package",
          "name": "httpx",
          "version": ">=0.28.1,<0.29",
          "import": "httpx"
        }
      ],
      "requires": [],
      "recommends": [],
      "capabilities": []
    },
    {
      "id": "criticism.source.rss",
      "type": "criticism.source",
      "version": "0.3.1",
      "entrypoint": "criticism_feeds:PLUGIN",
      "display_name": "Source RSS/Atom",
      "description": "Source de critiques publique RSS 2, Atom ou JSON Feed.",
      "help_text": "Configurez explicitement un flux public. Localhost, IP privées/réservées, DNS vers adresse non globale, peer TCP inattendu, redirections vers une cible non publique et downgrade HTTPS→HTTP sont refusés. La connexion TCP est épinglée sur l’adresse DNS validée tout en conservant SNI et vérification du certificat sur le hostname d’origine. Seuls les résumés sont conservés ; métadonnées du livre et de la critique restent distinctes.",
      "enabled_by_default": false,
      "priority": -100,
      "instantiation": "singleton_public",
      "capabilities": [
        "criticism.collect",
        "criticism.discover"
      ],
      "system_requires": [
        {
          "type": "python-package",
          "name": "httpx",
          "version": ">=0.28.1,<0.29",
          "import": "httpx"
        }
      ],
      "config_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "feed_url": {
            "type": "string",
            "default": "",
            "description": "URL HTTP(S) du flux public"
          }
        }
      },
      "requires": [],
      "recommends": [],
      "requires_brokers": [],
      "requires_contracts": []
    }
  ]
}
