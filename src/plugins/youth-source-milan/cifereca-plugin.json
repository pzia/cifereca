{
  "manifest": 1,
  "package": {
    "id": "org.cifereca.youth-source-milan",
    "version": "0.1.8",
    "name": "Jeunesse — Éditions Milan",
    "publisher": "CIFERECA",
    "plugin_api": ">=1.4,<2"
  },
  "plugins": [
    {
      "id": "youth.source.milan",
      "type": "youth.source",
      "version": "0.1.8",
      "entrypoint": "milan_youth:PLUGIN",
      "display_name": "Éditions Milan — âges éditeur",
      "description": "Catalogue public Milan avec âge minimum et ISBN publiés sur les fiches produit.",
      "help_text": "Catalogue Milan et recherche /recherche/books/?text=... ; au plus 8 fiches qualifiées par appel. Âge explicite et ISBN valide requis. Données de fiche attestées, sans inférence.",
      "enabled_by_default": false,
      "priority": -62,
      "instantiation": "singleton_public",
      "capabilities": [
        "youth.source.search",
        "youth.source.browse"
      ],
      "system_requires": [
        {
          "type": "python-package",
          "name": "httpx",
          "version": ">=0.28.1,<0.29",
          "import": "httpx"
        }
      ]
    }
  ]
}
